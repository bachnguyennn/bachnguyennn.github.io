    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.1.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}
