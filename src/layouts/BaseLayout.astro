---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/urls';

interface Props {
  /** Page name; " · Bach Nguyen" is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
  /** Absolute or site-relative path to a 1200×630 preview image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  /** Hide the chat launcher (e.g. on the printable resume it is hidden by CSS instead). */
  chat?: boolean;
}

const {
  title,
  description,
  fullTitle = false,
  image = '/og.png',
  imageAlt = 'Bach Nguyen — Machine Learning, Applied AI & Software Engineering',
  type = 'website',
  structuredData = [],
  chat = true,
} = Astro.props;

const site = Astro.site ?? new URL(profile.site);
const pageTitle = fullTitle ? title : `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image.startsWith('http') ? image : withBase(image), site).toString();

const person = {
  '@type': 'Person',
  '@id': `${new URL(withBase('/'), site)}#person`,
  name: profile.name,
  url: new URL(withBase('/'), site).toString(),
  image: new URL(withBase('/profile.jpg'), site).toString(),
  jobTitle: 'Undergraduate Thesis Researcher',
  description: profile.shortBio,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Oshawa', addressRegion: 'ON', addressCountry: 'CA' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Ontario Tech University' },
  affiliation: { '@type': 'Organization', name: 'Visual Computing Lab, Ontario Tech University' },
  knowsAbout: ['Machine learning', 'Continual learning', 'Vision transformers', 'Retrieval-augmented generation', 'Data engineering', 'Mathematics'],
  sameAs: [profile.github, profile.linkedin],
};
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [person, ...structuredData] });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
    {chat && <ChatWidget />}
  </body>
</html>
