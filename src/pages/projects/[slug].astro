---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.notebook !== false)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';
---

<BaseLayout
  title={`${project.data.title} — Bach Nguyen`}
  description={project.data.summary}
>
  <a class="back" href={href('/projects')}>← All projects</a>
  <p class="article-meta">{project.data.period} · {project.data.tags.join(' · ')}</p>
  <h1 class="page-title">{project.data.title}</h1>
  <p class="lead muted">{project.data.summary}</p>
  {project.data.github && (
    <div class="article-links">
      <a href={project.data.github} target="_blank" rel="noopener">Code on GitHub →</a>
    </div>
  )}

  <article class="prose">
    <Content />
  </article>
</BaseLayout>
