---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { projectCategories } from '../../lib/taxonomy';
import { displayTitle, getProjects, type Project } from '../../lib/projects';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const all = await getProjects();
  const pages = all.filter((p) => p.data.caseStudy && !p.data.href);
  return pages.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: pages[i - 1] ?? null, next: pages[i + 1] ?? null },
  }));
}

interface Props { project: Project; prev: Project | null; next: Project | null }
const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const toc = headings.filter((h) => h.depth === 2);
const isAskBach = project.id === 'ask-bach';
---

<BaseLayout
  title={displayTitle(project)}
  description={`${d.summary} Case study by Bach Nguyen.`}
  type="article"
  structuredData={[
    {
      '@type': 'CreativeWork',
      name: d.title,
      description: d.summary,
      author: { '@id': `${new URL(withBase('/'), Astro.site)}#person` },
      dateCreated: String(d.year),
      keywords: d.stack.join(', '),
      ...(d.github ? { codeRepository: d.github } : {}),
    },
  ]}
>
  <header class="page-header case-header">
    <div class="container">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href={withBase('/projects/')}>Projects</a> <span aria-hidden="true">/</span> <span aria-current="page">{displayTitle(project)}</span>
      </nav>
      <div class="case-meta">
        <StatusBadge status={d.status} />
        <span class="meta">{d.categories.map((c) => projectCategories[c]).join(' · ')}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="actions case-actions">
        {d.github && <a class="btn btn-primary" href={d.github} target="_blank" rel="noopener noreferrer">View code on GitHub</a>}
        {d.demo && <a class="btn btn-secondary" href={d.demo.url} target="_blank" rel="noopener noreferrer">Open {d.demo.label.toLowerCase()}</a>}
        {isAskBach && <button class="btn btn-secondary" type="button" data-open-chat>Try it now</button>}
      </div>
      {d.demo?.note && <p class="demo-note">{d.demo.note}</p>}
    </div>
  </header>

  <div class="container case-layout">
    <aside class="case-aside" aria-label="Project summary">
      <dl class="glance">
        <div><dt>Problem</dt><dd>{d.problem}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>When</dt><dd>{d.period}</dd></div>
        {d.statusNote && <div><dt>Status</dt><dd>{d.statusNote}</dd></div>}
        {d.result && (
          <div class="glance-result">
            <dt>Key result</dt>
            <dd><strong>{d.result.value}</strong> {d.result.label}{d.result.context && <span>{d.result.context}</span>}</dd>
          </div>
        )}
        <div>
          <dt>Stack</dt>
          <dd><ul class="tags">{d.stack.map((t) => <li class="tag">{t}</li>)}</ul></dd>
        </div>
      </dl>
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </aside>

    <article class="prose case-body">
      <Content />
    </article>
  </div>

  <nav class="container pager" aria-label="More case studies">
    {prev ? (
      <a class="pager-link" href={withBase(`/projects/${prev.id}/`)} rel="prev"><span>Previous</span>{displayTitle(prev)}</a>
    ) : <span />}
    <a class="pager-all" href={withBase('/projects/')}>All projects</a>
    {next ? (
      <a class="pager-link pager-next" href={withBase(`/projects/${next.id}/`)} rel="next"><span>Next</span>{displayTitle(next)}</a>
    ) : <span />}
  </nav>
</BaseLayout>

<style>
  .case-header h1 { font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.4rem); max-width: 22ch; }
  .crumbs { margin-bottom: var(--s-5); font-size: var(--fs-sm); color: var(--faint); }
  .crumbs a { color: var(--muted); }
  .case-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; margin-bottom: var(--s-4); }
  .case-actions { margin-top: var(--s-5); }
  .demo-note { margin: var(--s-3) 0 0; font-size: var(--fs-sm); color: var(--faint); }

  .case-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s-8); padding-block: var(--s-7) var(--s-8); align-items: start; }
  .case-body { grid-column: 1; grid-row: 1; }
  /* The summary scrolls with the page; only the short table of contents stays in view. */
  .case-aside { grid-column: 2; grid-row: 1; align-self: stretch; display: flex; flex-direction: column; gap: var(--s-5); }
  .toc { position: sticky; top: calc(var(--header-h) + var(--s-5)); }

  .glance { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .glance div { padding: var(--s-3) var(--s-4); border-top: 1px solid var(--line); }
  .glance div:first-child { border-top: 0; }
  .glance dt { margin-bottom: .2rem; font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }
  .glance dd { margin: 0; font-size: .875rem; line-height: 1.5; color: var(--ink-2); }
  .glance-result strong { display: block; font-family: var(--serif); font-size: 1.4rem; font-weight: 600; color: var(--accent-ink); line-height: 1.25; }
  .glance-result span { display: block; margin-top: .3rem; font-size: .8rem; color: var(--muted); }

  .toc-title { margin: 0 0 var(--s-2); font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: .3rem 0 .3rem var(--s-4); margin-left: -1px; border-left: 1px solid transparent; color: var(--muted); font-size: .875rem; text-decoration: none; }
  .toc a:hover { color: var(--ink); border-left-color: var(--accent); }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-4); padding-block: var(--s-6) var(--s-8); border-top: 1px solid var(--line); }
  .pager-link { display: flex; flex-direction: column; gap: .2rem; text-decoration: none; color: var(--ink); font-weight: 500; }
  .pager-link span { font: 500 var(--fs-xs) var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }
  .pager-link:hover { color: var(--accent-ink); }
  .pager-next { text-align: right; align-items: flex-end; }
  .pager-all { font-size: var(--fs-sm); }

  @media (max-width: 1000px) {
    .case-layout { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); padding-top: var(--s-6); }
    .case-aside { grid-column: 1; grid-row: 1; }
    .case-body { grid-row: 2; }
    .toc { display: none; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pager-all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
</style>
