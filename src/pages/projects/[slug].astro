---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, displayTitle, type Project } from '../../lib/projects';
import { projectStatuses } from '../../lib/taxonomy';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => p.data.caseStudy && !p.data.href)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout
  title={displayTitle(project)}
  description={`${d.summary} Write-up by Bach Nguyen.`}
  type="article"
>
  <a class="back" href={withBase('/projects/')}>← All projects</a>
  <p class="article-meta">{d.period} · {projectStatuses[d.status]} · {d.stack.join(' · ')}</p>
  <h1 class="page-title">{d.title}</h1>
  <p class="lead muted">{d.summary}</p>
  {d.statusNote && <p class="muted small">{d.statusNote}</p>}
  {(d.github || d.demo) && (
    <div class="article-links">
      {d.demo && <a href={d.demo.url} target="_blank" rel="noopener" title={d.demo.note}>{d.demo.label} →</a>}
      {d.github && <a href={d.github} target="_blank" rel="noopener">Code on GitHub →</a>}
    </div>
  )}

  <article class="prose">
    <Content />
  </article>
</BaseLayout>
