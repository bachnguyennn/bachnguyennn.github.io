---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, displayTitle, projectHref, hasInternalPage } from '../../lib/projects';
import { projectStatuses } from '../../lib/taxonomy';

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Machine learning and data engineering projects by Bach Nguyen, with write-ups covering design, evaluation, and limitations."
>
  <h1 class="page-title">Projects</h1>
  <p class="muted">Things I've built for research, work, and my own curiosity. Most have a longer write-up and all of them have code on GitHub. The status says what is deployed and what is not.</p>

  <section>
    <ul class="entries">
      {projects.map((p) => (
        <li class="entry">
          <div class="top"><h3>{displayTitle(p)}</h3><span class="date">{p.data.period}</span></div>
          <p class="sub">{projectStatuses[p.data.status]}{p.data.statusNote && ` · ${p.data.statusNote}`}</p>
          <p>{p.data.summary}</p>
          {p.data.result && (
            <p class="result">{p.data.result.value} {p.data.result.label}{p.data.result.context && <span>. {p.data.result.context}</span>}</p>
          )}
          <p class="tags">{p.data.stack.join(' · ')}</p>
          <span class="more">
            {hasInternalPage(p) && <a href={projectHref(p)}>{p.data.href ? 'Research →' : 'Write-up →'}</a>}
            {p.data.demo && <a href={p.data.demo.url} target="_blank" rel="noopener" title={p.data.demo.note}>{p.data.demo.label} →</a>}
            {p.data.github && <a href={p.data.github} target="_blank" rel="noopener">GitHub →</a>}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
