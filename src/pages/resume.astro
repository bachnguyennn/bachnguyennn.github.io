---
// The full resume as HTML: readable without JavaScript, printable, and built from the same data as
// the rest of the site. public/Resume.pdf is a separate one-page file and is not generated from this.
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { education, coursework } from '../data/education';
import { workExperience, leadership } from '../data/experience';
import { skillGroups } from '../data/skills';
import { certifications } from '../data/certifications';
import { thesis, milestones } from '../data/research';
import { getProjects, displayTitle, hasInternalPage, projectHref } from '../lib/projects';
import { withBase } from '../lib/urls';

const projects = (await getProjects()).filter((p) => p.id !== 'cascadedvit-research');
const resumeProjects = projects.filter((p) => p.data.resume).sort((a, b) => a.data.order - b.data.order);
const otherProjects = projects.filter((p) => !p.data.resume);
const pdfHref = withBase(profile.resumePdf);
const orgLine = (e: { org: string; orgDetail?: string; location: string }) => [e.org, e.orgDetail, e.location].filter(Boolean).join(' · ');
---

<BaseLayout
  title="Resume"
  description="Resume of Bach Nguyen: BSc Integrated Mathematics and Computer Science at Ontario Tech University (April 2027), thesis research in continual learning, ML and data engineering projects, and industry experience."
  type="profile"
>
  <div class="resume-actions no-print">
    <a href={pdfHref} target="_blank" rel="noopener">Download PDF</a>
    <button type="button" class="linklike" data-print hidden>Print</button>
  </div>

  <h1 class="page-title">{profile.name}</h1>
  <p class="resume-contact">
    <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
    <a href={profile.phoneHref}>{profile.phone}</a> ·
    <a href={profile.linkedin} target="_blank" rel="noopener">linkedin.com/in/{profile.linkedinHandle}</a> ·
    <a href={profile.github} target="_blank" rel="noopener">github.com/{profile.githubHandle}</a> ·
    <a href={profile.site}>{profile.site.replace(/^https?:\/\//, '')}</a> ·
    {profile.location}
  </p>

  <section id="education">
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="top"><h3>{education.school}</h3><span class="date">{education.start} – {education.end}</span></div>
      <p class="sub">{education.degree} · {education.location}</p>
      <ul>
        <li>Cumulative GPA: {education.gpa} · {education.honours.join(', ')}</li>
        {coursework.map((g) => (
          <li id={g === coursework[0] ? 'coursework' : undefined}>
            {g.label} coursework: {g.courses.map((c) => (c.current ? `${c.name} (in progress)` : c.name)).join(', ')}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="experience">
    <h2 class="section-title">Experience</h2>
    <ul class="entries">
      {workExperience.map((e) => (
        <li class="entry">
          <div class="top"><h3>{e.role}{e.roleDetail && `, ${e.roleDetail}`}</h3><span class="date">{e.date}</span></div>
          <p class="sub">{orgLine(e)}</p>
          <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ul>
  </section>

  <section id="research">
    <h2 class="section-title">Research</h2>
    <div class="entry">
      <div class="top"><h3><a href={withBase('/research/')}>{thesis.title}</a></h3><span class="date">{thesis.start} – Present</span></div>
      <p class="sub">Undergraduate thesis · {thesis.lab} · Supervisor: {thesis.supervisor}</p>
      <ul>
        <li>{thesis.question}</li>
        {milestones.filter((m) => m.status !== 'planned').map((m) => <li>{m.body}</li>)}
      </ul>
    </div>
  </section>

  <section id="projects">
    <h2 class="section-title">Projects</h2>
    <ul class="entries">
      {resumeProjects.map((p) => (
        <li class="entry">
          <div class="top"><h3><a href={projectHref(p)}>{displayTitle(p)}</a></h3><span class="date">{p.data.year}</span></div>
          <p class="tags">{p.data.stack.slice(0, 6).join(' · ')}</p>
          <ul>{p.data.resume!.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ul>
    <h3 class="resume-sub">Other projects</h3>
    <ul class="resume-list">
      {otherProjects.map((p) => (
        <li>
          <a href={projectHref(p)} {...(hasInternalPage(p) ? {} : { target: '_blank', rel: 'noopener' })}>{displayTitle(p)}</a> ({p.data.year}): {p.data.summary}
        </li>
      ))}
    </ul>
  </section>

  <section id="skills">
    <h2 class="section-title">Technical skills</h2>
    <ul class="resume-list">
      {skillGroups.map((g) => <li><strong>{g.label}:</strong> {g.items.join(', ')}</li>)}
    </ul>
  </section>

  <section id="leadership">
    <h2 class="section-title">Leadership &amp; community</h2>
    <ul class="entries">
      {leadership.map((e) => (
        <li class="entry">
          <div class="top"><h3>{e.role}</h3><span class="date">{e.date}</span></div>
          <p class="sub">{orgLine(e)}</p>
          <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ul>
  </section>

  <section id="certifications">
    <h2 class="section-title">Certifications</h2>
    <ul class="entries certs">
      {certifications.map((c) => <li>{c.name}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-print]');
  if (btn) {
    btn.hidden = false;
    btn.addEventListener('click', () => window.print());
  }
</script>
