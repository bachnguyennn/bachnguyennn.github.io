---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { workExperience, leadership } from '../data/experience';
import { education, coursework } from '../data/education';
import { certifications } from '../data/certifications';
import { withBase } from '../lib/urls';

const list = (cs: { name: string; current?: boolean }[]) =>
  cs.map((c) => (c.current ? `${c.name} (in progress)` : c.name)).join(', ');
---

<BaseLayout
  title="Experience"
  description="Bach Nguyen's experience: undergraduate thesis research in the Visual Computing Lab, teaching, an IT internship at the Canadian Mental Health Association, volunteer data engineering, and student leadership."
>
  <h1 class="page-title">Experience</h1>
  <p class="muted">The same information as my <a href={withBase('/resume/')}>resume</a>, newest first.</p>

  <section>
    <ExperienceList entries={workExperience} details live />
  </section>

  <section>
    <h2 class="section-title">Leadership &amp; community</h2>
    <ExperienceList entries={leadership} details />
  </section>

  <section>
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="top"><h3>{education.school}</h3><span class="date">{education.start} – {education.end}</span></div>
      <p class="sub">{education.degree}</p>
      <ul>
        <li>GPA {education.gpa} · {education.honours.join(', ')}</li>
        {coursework.map((g) => <li>{g.label} coursework: {list(g.courses)}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-title">Certifications</h2>
    <ul class="entries certs">
      {certifications.map((c) => <li>{c.name}</li>)}
    </ul>
  </section>
</BaseLayout>
