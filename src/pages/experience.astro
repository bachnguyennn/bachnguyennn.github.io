---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${basePath}/${p}`;
---

<BaseLayout
  title="Experience — Bach Nguyen"
  description="Research, teaching, IT, and data engineering experience."
>
  <h1 class="page-title">Experience</h1>
  <p class="muted">The same information as my <a href={asset('Resume.pdf')} target="_blank" rel="noopener">resume</a>, newest first.</p>

  <section>
    <ul class="entries">
      {experience.map((e) => (
        <li class="entry">
          <div class="top"><h3>{e.role}</h3><span class="date">{e.date}</span></div>
          <p class="sub">{e.org}</p>
          <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="top"><h3>Ontario Tech University</h3><span class="date">Sep 2023 – Apr 2027</span></div>
      <p class="sub">BSc (Hons), Integrated Mathematics &amp; Computer Science (Co-op)</p>
      <ul>
        <li>GPA 3.77 / 4.3 · President's List (3×), Dean's List</li>
        <li>Relevant coursework: Data Mining, Database Systems, Scientific Data Analysis, Data Structures, Statistics &amp; Probability</li>
      </ul>
    </div>
  </section>
</BaseLayout>
