---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceList from '../components/ExperienceList.astro';
import AskBachDiagram from '../components/diagrams/AskBachDiagram.astro';
import ContinualLearningDiagram from '../components/diagrams/ContinualLearningDiagram.astro';
import portrait from '../assets/profile.jpg';
import { profile } from '../data/profile';
import { workExperience } from '../data/experience';
import { education, coursework } from '../data/education';
import { expertise } from '../data/skills';
import { thesis, milestones } from '../data/research';
import { getProjects } from '../lib/projects';
import { withBase } from '../lib/urls';

const projects = await getProjects();
const byId = (id: string) => projects.find((p) => p.id === id)!;
const askBach = byId('ask-bach');
const marketGuard = byId('market-guard');
const research = byId('cascadedvit-research');
const xray = byId('chest-xray-pneumonia');

const keyCourses = coursework.flatMap((g) => g.courses.filter((c) => c.key));
const milestoneLabel = { done: 'Done', 'in-progress': 'In progress', planned: 'Next' } as const;

const facts = [
  { k: 'Research', v: 'Continual learning for efficient vision transformers', href: '/research/' },
  { k: 'Deployed', v: 'Hybrid-retrieval RAG service on Azure Container Apps', href: '/projects/ask-bach/' },
  { k: 'Industry', v: 'IT intern at CMHA: booking automation and IT support for 100+ staff', href: '/experience/#cmha-experience' },
  { k: 'Academics', v: `${education.gpa} GPA · ${education.honours[0]}`, href: '/resume/#education' },
];
---

<BaseLayout
  title={`${profile.name} · Machine Learning & Software Engineering`}
  fullTitle
  description="Bach Nguyen is a Mathematics and Computer Science student at Ontario Tech University researching continual learning for efficient vision transformers and building ML, data, and cloud software. Graduating April 2027."
  type="profile"
  structuredData={[
    { '@type': 'WebSite', name: profile.name, url: new URL(withBase('/'), Astro.site).toString() },
    { '@type': 'ProfilePage', mainEntity: { '@id': `${new URL(withBase('/'), Astro.site)}#person` } },
  ]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Ontario Tech University · Graduating {profile.graduation}</p>
        <h1>{profile.name}</h1>
        <p class="hero-role">{profile.headline}</p>
        <p class="hero-intro">
          I’m a fourth-year Mathematics and Computer Science student. In the Visual Computing Lab I research
          <a href={withBase('/research/')}>continual learning for efficient vision transformers</a>, and outside it I build
          software where machine learning meets data infrastructure and the cloud, from a
          <a href={withBase('/projects/ask-bach/')}>retrieval-augmented chatbot on Azure</a> to a
          <a href={withBase('/projects/market-guard/')}>replay-safe Spark pipeline</a>.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={withBase('/projects/')}>View projects</a>
          <a class="btn btn-secondary" href={withBase('/research/')}>Read research</a>
          <a class="btn btn-secondary" href={withBase('/resume/')}>Resume</a>
        </div>
        <ul class="hero-links" aria-label="Contact and profiles">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={withBase(profile.resumePdf)} download="Bach-Nguyen-Resume.pdf">Download PDF resume</a></li>
        </ul>
      </div>

      <aside class="hero-aside" aria-label="At a glance">
        <figure class="portrait">
          <Image src={portrait} alt="Portrait of Bach Nguyen" widths={[240, 360, 480]} sizes="(min-width: 960px) 300px, 180px" loading="eager" fetchpriority="high" />
        </figure>
        <dl class="now">
          <div><dt>Now</dt><dd>Thesis researcher, Visual Computing Lab</dd></div>
          <div><dt>Also</dt><dd>Teaching assistant, engineering math</dd></div>
          <div><dt>Based</dt><dd>{profile.location}</dd></div>
          <div class="now-open"><dt>Open to</dt><dd>New-grad ML, applied AI &amp; software roles from 2027</dd></div>
        </dl>
      </aside>
    </div>

    <div class="container">
      <ul class="facts">
        {facts.map((f) => (
          <li>
            <a href={withBase(f.href)}>
              <span class="fact-k">{f.k}</span>
              <span class="fact-v">{f.v}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="num">01</span> Selected work</p>
          <h2 id="work-title">Projects that show how I work</h2>
          <p>Each one has a write-up covering the design, the evaluation, and what did not work.</p>
        </div>
        <a class="section-link text-link" href={withBase('/projects/')}>All {projects.length} projects <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <div class="work-stack">
        <ProjectCard project={askBach} variant="feature">
          <AskBachDiagram slot="visual" compact vertical caption={false} />
        </ProjectCard>
        <ProjectCard project={marketGuard} variant="feature" />
        <div class="grid-2">
          <ProjectCard project={research} />
          <ProjectCard project={xray} />
        </div>
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="section section-research" aria-labelledby="research-title">
    <div class="container research-grid">
      <div>
        <p class="eyebrow"><span class="num">02</span> Current research</p>
        <h2 id="research-title" class="research-title">{thesis.shortTitle}</h2>
        <p class="meta">{thesis.lab} · Supervised by {thesis.supervisor} · Since {thesis.start}</p>
        <p class="research-summary">{thesis.summary}</p>
        <p class="research-question"><span>Research question</span>{thesis.question}</p>
        <a class="text-link" href={withBase('/research/')}>Read about the research <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="research-side">
        <ContinualLearningDiagram variant="setting" />
        <ol class="milestones">
          {milestones.map((m) => (
            <li class={`ms-${m.status}`}>
              <span class="ms-status">{milestoneLabel[m.status]}</span>
              <span class="ms-title">{m.title}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" aria-labelledby="xp-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="num">03</span> Experience</p>
          <h2 id="xp-title">Research, teaching, and industry</h2>
        </div>
        <a class="section-link text-link" href={withBase('/experience/')}>Full experience <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ExperienceList entries={workExperience} variant="compact" />
    </div>
  </section>

  <!-- Expertise -->
  <section class="section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="num">04</span> Technical expertise</p>
          <h2 id="skills-title">What I can show, not just list</h2>
          <p>Every area links to the work where I used it. The complete skills list is on the <a href={withBase('/resume/#skills')}>resume</a>.</p>
        </div>
      </div>
      <div class="expertise">
        {expertise.map((area) => (
          <article class="card expertise-card">
            <h3>{area.title}</h3>
            <p>{area.body}</p>
            <ul class="tags" aria-label="Tools">{area.tools.map((t) => <li class="tag">{t}</li>)}</ul>
            <p class="evidence">
              <span>Shown in</span>
              {area.evidence.map((e, i) => (
                <>{i > 0 && ' · '}<a href={withBase(e.href)}>{e.label}</a></>
              ))}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Education + About -->
  <section class="section" aria-labelledby="edu-title">
    <div class="container edu-grid">
      <div>
        <p class="eyebrow"><span class="num">05</span> Education</p>
        <h2 id="edu-title" class="sub-title">{education.school}</h2>
        <p class="edu-degree">{education.degree}</p>
        <p class="meta">{education.start} – {education.end}</p>
        <dl class="edu-stats">
          <div><dt>GPA</dt><dd>{education.gpa}</dd></div>
          {education.honours.map((h) => {
            const [label, count] = h.split(' (');
            return <div><dt>{label}</dt><dd>{count?.replace(')', '')}</dd></div>;
          })}
        </dl>
        <h3 class="mini-title">Key coursework</h3>
        <ul class="tags course-tags">
          {keyCourses.map((c) => <li class="tag">{c.name}{c.current && ' (in progress)'}</li>)}
        </ul>
        <a class="text-link" href={withBase('/resume/#coursework')}>All coursework <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <div class="about">
        <p class="eyebrow"><span class="num">06</span> About</p>
        <h2 class="sub-title">A little more about me</h2>
        <p>I like problems that sit between mathematics, data, and software. My degree pairs analysis, linear algebra, and optimization with algorithms and systems, and I lean on both: the math to understand why a method should work, the engineering to find out whether it does.</p>
        <p>Before research, I spent a summer at the Canadian Mental Health Association automating scheduling and keeping IT running for clinical staff, and I volunteered as a data engineer with Statistics Without Borders. These days I also teach a weekly math tutorial and help run the CS Club’s hackathon.</p>
        <p>Outside of school and work I read a lot and watch a lot of football.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact-cta" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div>
        <p class="eyebrow"><span class="num">07</span> Contact</p>
        <h2 id="contact-title">Let’s talk</h2>
        <p>I’m looking for new-graduate roles in machine learning, applied AI, and software engineering starting after April 2027. Email is the fastest way to reach me.</p>
      </div>
      <div class="actions">
        <a class="btn btn-accent" href={`mailto:${profile.email}`}>Email me</a>
        <a class="btn btn-secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn-secondary" href={withBase('/contact/')}>Other ways to reach me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .hero { padding-block: var(--s-8) var(--s-7); border-bottom: 1px solid var(--line);
    background:
      linear-gradient(to bottom, transparent, var(--bg) 92%),
      repeating-linear-gradient(to right, color-mix(in srgb, var(--line) 55%, transparent) 0 1px, transparent 1px 96px);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s-8); align-items: start; }
  .hero h1 { font-family: var(--serif); font-size: var(--fs-display); font-weight: 500; letter-spacing: -.03em; line-height: 1; }
  .hero-role { margin: var(--s-4) 0 0; font-family: var(--serif); font-size: var(--fs-xl); font-style: italic; color: var(--ink-2); line-height: 1.3; }
  .hero-intro { margin: var(--s-5) 0 var(--s-6); max-width: 60ch; font-size: var(--fs-md); line-height: 1.65; color: var(--ink-2); }
  .hero-links { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin: var(--s-5) 0 0; padding: 0; list-style: none; font-size: var(--fs-sm); }
  .hero-links a { color: var(--muted); }
  .hero-links a:hover { color: var(--accent-ink); }

  .hero-aside { display: flex; flex-direction: column; gap: var(--s-4); }
  .portrait { margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); background: var(--surface-2); aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .now { margin: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .now div { display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--s-3); padding: .6rem .9rem; border-top: 1px solid var(--line); }
  .now div:first-child { border-top: 0; }
  .now dt { font: 500 var(--fs-xs)/1.6 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }
  .now dd { margin: 0; font-size: .875rem; line-height: 1.45; color: var(--ink-2); }
  .now-open dd { color: var(--ok); font-weight: 500; }

  .facts { list-style: none; margin: var(--s-7) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
  .facts li + li { border-left: 1px solid var(--line); }
  .facts a { display: flex; flex-direction: column; gap: .3rem; height: 100%; padding: var(--s-4) var(--s-5); text-decoration: none; color: var(--ink); }
  .facts a:hover { background: var(--surface-2); }
  .fact-k { font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent-ink); }
  .fact-v { font-size: .9rem; line-height: 1.45; color: var(--ink-2); }

  /* work */
  .work-stack { display: grid; gap: var(--s-5); }

  /* research */
  .section-research { background: var(--surface); }
  .research-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--s-8); align-items: start; }
  .research-title { font-family: var(--serif); font-size: var(--fs-2xl); font-weight: 500; letter-spacing: -.015em; margin-bottom: var(--s-2); }
  .research-summary { margin: var(--s-4) 0; color: var(--ink-2); }
  .research-question { margin: 0 0 var(--s-5); padding: var(--s-4); border-left: 2px solid var(--accent); background: var(--accent-soft); font-family: var(--serif); font-size: 1.15rem; line-height: 1.45; color: var(--ink); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .research-question span { display: block; margin-bottom: .3rem; font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent-ink); }
  .research-side :global(.figure-diagram) { margin-top: 0; }
  .milestones { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .milestones li { display: flex; align-items: baseline; gap: var(--s-3); font-size: .9375rem; }
  .ms-status { flex: none; width: 6.5rem; font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .06em; }
  .ms-done .ms-status { color: var(--ok); }
  .ms-in-progress .ms-status { color: var(--violet); }
  .ms-planned .ms-status { color: var(--faint); }

  /* expertise */
  .expertise { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr)); gap: var(--s-4); }
  .expertise-card { padding: var(--s-5); gap: var(--s-3); }
  .expertise-card h3 { font-size: 1.0625rem; }
  .expertise-card p { margin: 0; font-size: .9rem; color: var(--ink-2); }
  .expertise-card .evidence { margin-top: auto; padding-top: var(--s-2); font-size: .85rem; color: var(--muted); }
  .evidence span { margin-right: .4rem; font: 500 var(--fs-xs) var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }

  /* education + about */
  .edu-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); }
  .sub-title { font-family: var(--serif); font-size: var(--fs-xl); font-weight: 500; margin-bottom: var(--s-2); }
  .edu-degree { margin: 0; color: var(--ink-2); }
  .edu-stats { display: flex; flex-wrap: wrap; gap: var(--s-3); margin: var(--s-5) 0; }
  .edu-stats div { padding: var(--s-3) var(--s-4); border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .edu-stats dt { font: 500 var(--fs-xs)/1.4 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--faint); }
  .edu-stats dd { margin: .1rem 0 0; font-family: var(--serif); font-size: 1.35rem; font-weight: 500; }
  .mini-title { font-size: .9rem; font-weight: 600; margin-bottom: var(--s-3); }
  .course-tags { margin-bottom: var(--s-4); }
  .about p { color: var(--ink-2); }

  /* contact */
  .contact-cta { background: var(--ink); color: var(--bg); border-top: 0 !important; }
  .contact-cta h2 { color: var(--bg); font-family: var(--serif); font-size: var(--fs-2xl); font-weight: 500; }
  .contact-cta p { color: color-mix(in srgb, var(--bg) 78%, var(--ink)); max-width: 56ch; margin: var(--s-3) 0 0; }
  .contact-cta .eyebrow, .contact-cta .eyebrow .num { color: color-mix(in srgb, var(--bg) 65%, var(--ink)); }
  .contact-inner { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-6); }
  .contact-cta .btn-secondary { background: transparent; color: var(--bg); border-color: color-mix(in srgb, var(--bg) 40%, transparent); }
  .contact-cta .btn-secondary:hover { border-color: var(--bg); }
  .contact-cta .btn-accent { background: var(--bg); color: var(--ink); }
  .contact-cta .btn-accent:hover { background: color-mix(in srgb, var(--bg) 88%, var(--ink)); color: var(--ink); }
  .contact-cta :focus-visible { outline-color: var(--bg); }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .hero-aside { flex-direction: row; align-items: stretch; }
    .portrait { width: 160px; flex: none; }
    .now { flex: 1; align-content: start; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts li:nth-child(3) { border-left: 0; }
    .facts li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .research-grid, .edu-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  }
  @media (max-width: 560px) {
    .hero { padding-top: var(--s-7); }
    .hero-aside { flex-direction: column; }
    .portrait { width: 132px; }
    .now div { grid-template-columns: 4rem 1fr; }
    .facts { grid-template-columns: minmax(0, 1fr); }
    .facts li + li { border-left: 0; border-top: 1px solid var(--line); }
    .actions .btn { flex: 1 1 auto; }
  }
</style>
