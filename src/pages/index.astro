---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { education, coursework } from '../data/education';
import { certifications } from '../data/certifications';
import { getProjects, displayTitle, projectHref, hasInternalPage } from '../lib/projects';
import { projectStatuses } from '../lib/taxonomy';
import { withBase } from '../lib/urls';

const asset = (p: string) => withBase(`/${p}`);
const all = await getProjects();
const featured = all.filter((p) => p.data.featured);

// Icons live in public/tools/ (vendored from Iconify: devicon, selfhst, vscode-icons, arcticons).
// Items without an icon render as plain chips.
const toolGroups: { label: string; items: { name: string; icon?: string; invertDark?: boolean }[] }[] = [
  {
    label: 'Languages',
    items: [
      { name: 'Python', icon: 'python' },
      { name: 'SQL', icon: 'sql' },
      { name: 'Java', icon: 'java' },
      { name: 'C++', icon: 'cplusplus' },
      { name: 'Bash', icon: 'bash', invertDark: true },
    ],
  },
  {
    label: 'Machine learning & data',
    items: [
      { name: 'PyTorch', icon: 'pytorch' },
      { name: 'scikit-learn', icon: 'scikit-learn' },
      { name: 'pandas', icon: 'pandas', invertDark: true },
      { name: 'NumPy', icon: 'numpy' },
      { name: 'SciPy', icon: 'scipy' },
      { name: 'Matplotlib', icon: 'matplotlib' },
      { name: 'Jupyter', icon: 'jupyter' },
      { name: 'XGBoost / LightGBM' },
      { name: 'SHAP' },
    ],
  },
  {
    label: 'Applied AI, backend & data engineering',
    items: [
      { name: 'FastAPI' },
      { name: 'RAG / hybrid retrieval' },
      { name: 'Apache Spark' },
      { name: 'Delta Lake' },
      { name: 'Apache Kafka' },
      { name: 'Airflow', icon: 'airflow' },
      { name: 'BeautifulSoup', icon: 'beautifulsoup' },
    ],
  },
  {
    label: 'Cloud & Microsoft',
    items: [
      { name: 'Azure', icon: 'azure' },
      { name: 'Docker', icon: 'docker' },
      { name: 'GitHub Actions' },
      { name: 'SharePoint', icon: 'sharepoint' },
      { name: 'Power Apps', icon: 'power-apps' },
      { name: 'Power Automate', icon: 'power-automate' },
      { name: 'Excel / Power Query', icon: 'excel' },
    ],
  },
  {
    label: 'Databases & dev tools',
    items: [
      { name: 'Azure Cosmos DB' },
      { name: 'MySQL', icon: 'mysql', invertDark: true },
      { name: 'SQLite', icon: 'sqlite' },
      { name: 'IBM DB2', icon: 'db2', invertDark: true },
      { name: 'Git', icon: 'git' },
      { name: 'Visual Studio', icon: 'visual-studio' },
    ],
  },
];
---

<BaseLayout
  title={`${profile.name} · ${profile.headline}`}
  fullTitle
  description="Bach Nguyen builds machine learning systems and data pipelines and researches continual learning for efficient vision models at Ontario Tech University. Open to new-graduate ML engineering and data engineering roles after April 2027."
  type="profile"
>
  <div class="intro">
    <div class="avatar"><img src={asset('profile.jpg')} alt="Bach Nguyen" width="72" height="72" /></div>
    <div>
      <h1>Bach Nguyen</h1>
      <p class="role">{profile.headline} · Ontario Tech University · graduating April 2027</p>
    </div>
  </div>

  <p class="lead">
    I build machine learning systems and the data pipelines. My undergraduate thesis in the Visual Computing Lab studies
    <a href={withBase('/research/')}>how small, efficient vision models can keep learning new tasks</a>.
  </p>
  <p class="muted">{profile.availability}</p>

  <div class="links">
    <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
    <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={withBase('/resume/')}>Resume</a>
    <a href={asset('Resume.pdf')} target="_blank" rel="noopener">Resume (PDF)</a>
    <a href={`mailto:${profile.email}`}>Email</a>
  </div>

  <section>
    <h2 class="section-title">Selected projects</h2>
    <ul class="entries">
      {featured.map((p) => {
        const internal = hasInternalPage(p);
        return (
          <li class="entry">
            <h3>{displayTitle(p)}</h3>
            <p class="sub">{projectStatuses[p.data.status]} · {p.data.period}</p>
            <p>{p.data.summary}</p>
            {p.data.result && (
              <p class="result">{p.data.result.value} {p.data.result.label}{p.data.result.context && <span>. {p.data.result.context}</span>}</p>
            )}
            <p class="tags">{p.data.stack.join(' · ')}</p>
            <span class="more">
              {internal && <a href={projectHref(p)}>{p.data.href ? 'Research →' : 'Write-up →'}</a>}
              {p.data.demo && <a href={p.data.demo.url} target="_blank" rel="noopener" title={p.data.demo.note}>{p.data.demo.label} →</a>}
              {p.data.github && <a href={p.data.github} target="_blank" rel="noopener">GitHub →</a>}
            </span>
          </li>
        );
      })}
    </ul>
    <p style="margin-top:1.75rem"><a href={withBase('/projects/')}>All projects →</a></p>
  </section>

  <section>
    <h2 class="section-title">Experience</h2>
    <ExperienceList entries={experience} />
    <p style="margin-top:1.75rem"><a href={withBase('/experience/')}>Details →</a></p>
  </section>

  <section>
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="top"><h3>{education.school}</h3><span class="date">2023 – 2027</span></div>
      <p class="sub">{education.degree}</p>
      <p class="muted">GPA {education.gpa} · {education.honours.join(', ')}</p>
    </div>
  </section>

  <section>
    <h2 class="section-title">Relevant coursework</h2>
    <div class="tool-groups">
      {coursework.map((g) => (
        <div class="tool-group">
          <h3>{g.label}</h3>
          <ul class="tool-list">
            {g.courses.map((c) => (
              <li class="tool course">{c.name}{c.current && <span class="current">in progress</span>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-title">Certifications</h2>
    <ul class="entries certs">
      {certifications.map((c) => <li>{c.name}</li>)}
    </ul>
  </section>

  <section>
    <h2 class="section-title">About</h2>
    <p>I'm a fourth-year Integrated Mathematics and Computer Science student at Ontario Tech University.</p>
    <p>At the Canadian Mental Health Association, I automated scheduling and supported IT systems. In a short Statistics Without Borders project, I designed sample Azure data pipelines. I now research continual learning and computer vision, TA first-year engineering math, and help run the CS Club's hackathon.</p>
    <p>Outside of school and work, I love reading books and watching football.</p>
  </section>

  <section id="contact">
    <h2 class="section-title">Get in touch</h2>
    <p>The best way to reach me is <a href={`mailto:${profile.email}`}>{profile.email}</a>. I'm also on <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a> and <a href={profile.github} target="_blank" rel="noopener">GitHub</a>.</p>
  </section>

  <section id="tools">
    <h2 class="section-title">Tools I use</h2>
    <div class="tool-groups">
      {toolGroups.map((g) => (
        <div class="tool-group">
          <h3>{g.label}</h3>
          <ul class="tool-list">
            {g.items.map((t) => (
              <li class:list={['tool', { course: !t.icon }]}>
                {t.icon && <img src={asset(`tools/${t.icon}.svg`)} class:list={[{ 'invert-dark': t.invertDark }]} alt="" width="20" height="20" loading="lazy" />}
                <span>{t.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
