---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';
const asset = (p: string) => `${basePath}/${p}`;

const work = [
  {
    title: 'Continual Learning Research',
    sub: 'Ontario Tech Visual Computing Lab',
    body: 'Implemented a 10M-parameter CascadedViT variant under CPG (Compacting, Picking, and Growing). Currently working on the expert-routing mechanism in SEMA with a CascadedViT co-author.',
    tags: 'Python · PyTorch · Vision Transformers',
  },
  {
    title: 'Booking Automation',
    sub: 'Canadian Mental Health Association',
    body: 'Built booking workflows in Power Apps and Power Automate that eliminated recurring double-booking errors and saved staff an estimated 5+ hours of manual scheduling per week.',
    tags: 'Power Apps · Power Automate · SharePoint',
  },
  {
    title: 'Hospital Readmission Risk Model',
    sub: 'Personal project',
    body: 'Modelled 30-day readmission risk on ~100K patient encounters with chronological splits, patient deduplication, and AUPRC-first evaluation, then used SHAP to find the main risk drivers.',
    tags: 'Python · XGBoost · LightGBM · SHAP',
    links: [
      { label: 'Write-up →', url: href('/projects/hospital-readmission') },
      { label: 'GitHub →', url: 'https://github.com/bachnguyennn/Hospital_Readmission_prediction' },
    ],
  },
];

const tools = [
  'Python', 'SQL', 'Java', 'C++', 'Bash', 'pandas', 'NumPy', 'scikit-learn', 'PyTorch',
  'Azure', 'SharePoint', 'Power Apps', 'Power Automate', 'Excel / Power Query',
  'MySQL', 'SQLite', 'Docker', 'Airflow', 'Git',
];
---

<BaseLayout
  title="Bach Nguyen"
  description="Integrated Mathematics & Computer Science student at Ontario Tech University. I build software, data systems, and machine learning projects."
>
  <div class="intro">
    <div class="avatar"><img src={asset('profile.jpg')} alt="Bach Nguyen" width="72" height="72" /></div>
    <div>
      <h1>Bach Nguyen</h1>
      <p class="role">Mathematics &amp; Computer Science student, Ontario Tech University</p>
    </div>
  </div>

  <p class="lead">I build software, data systems, and machine learning projects. I'm finishing my BSc at Ontario Tech and doing undergraduate thesis research on continual learning in the Visual Computing Lab.</p>

  <div class="links">
    <a href="https://github.com/bachnguyennn" target="_blank" rel="noopener">GitHub</a>
    <a href="https://www.linkedin.com/in/bach-nguyen-vu" target="_blank" rel="noopener">LinkedIn</a>
    <a href={asset('Resume.pdf')} target="_blank" rel="noopener">Resume</a>
    <a href="mailto:vubach.nguyen@ontariotechu.net">Email</a>
  </div>

  <section>
    <h2 class="section-title">Selected work</h2>
    <ul class="entries">
      {work.map((w) => (
        <li class="entry">
          <h3>{w.title}</h3>
          <p class="sub">{w.sub}</p>
          <p>{w.body}</p>
          <p class="tags">{w.tags}</p>
          {w.links && (
            <span class="more">
              {w.links.map((l) => (
                <a href={l.url} {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
              ))}
            </span>
          )}
        </li>
      ))}
    </ul>
    <p style="margin-top:1.75rem"><a href={href('/projects')}>All projects →</a></p>
  </section>

  <section>
    <h2 class="section-title">Experience</h2>
    <ul class="entries">
      {experience.map((e) => (
        <li class="entry">
          <div class="top"><h3>{e.role}</h3><span class="date">{e.date}</span></div>
          <p class="sub">{e.org}</p>
        </li>
      ))}
    </ul>
    <p style="margin-top:1.75rem"><a href={href('/experience')}>Details →</a></p>
  </section>

  <section>
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="top"><h3>Ontario Tech University</h3><span class="date">2023 – 2027</span></div>
      <p class="sub">BSc (Hons), Integrated Mathematics &amp; Computer Science (Co-op)</p>
      <p class="muted">GPA 3.77 / 4.3 · President's List (3×), Dean's List</p>
    </div>
  </section>

  <section>
    <h2 class="section-title">Tools</h2>
    <p class="muted">{tools.join(' · ')}</p>
  </section>

  <section>
    <h2 class="section-title">About</h2>
    <p>I'm a fourth-year Integrated Mathematics and Computer Science student at Ontario Tech University.</p>
    <p>I like problems that sit between software, data, and mathematics. I've worked on internal IT systems and automation at the Canadian Mental Health Association, designed Azure data pipelines with Statistics Without Borders, and I'm now doing undergraduate research in continual learning and computer vision.</p>
    <p>Outside of school and work: reading books and watching Barcelona and Arsenal.</p>
  </section>

  <section id="contact">
    <h2 class="section-title">Get in touch</h2>
    <p>The best way to reach me is <a href="mailto:vubach.nguyen@ontariotechu.net">vubach.nguyen@ontariotechu.net</a>. I'm also on <a href="https://www.linkedin.com/in/bach-nguyen-vu" target="_blank" rel="noopener">LinkedIn</a> and <a href="https://github.com/bachnguyennn" target="_blank" rel="noopener">GitHub</a>.</p>
  </section>
</BaseLayout>
