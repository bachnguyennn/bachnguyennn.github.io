---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/urls';

const channels = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}`, note: 'The best way to reach me. I usually reply within a couple of days.' },
  { label: 'LinkedIn', value: `in/${profile.linkedinHandle}`, href: profile.linkedin, note: 'For connecting and messages.', external: true },
  { label: 'GitHub', value: profile.githubHandle, href: profile.github, note: 'Code for every project on this site.', external: true },
];
---

<BaseLayout
  title="Contact"
  description="How to contact Bach Nguyen about new-graduate machine learning, applied AI, and software engineering roles, research, or projects."
>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">
        I’m graduating in {profile.graduation} and looking for new-graduate roles in machine learning, applied AI, and software engineering.
        I’m also happy to talk about my research or any of the projects here.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container contact-grid">
      <ul class="channels">
        {channels.map((c) => (
          <li class="card channel">
            <span class="eyebrow">{c.label}</span>
            <a class="channel-value" href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{c.value}</a>
            <p>{c.note}</p>
          </li>
        ))}
      </ul>
      <div class="contact-side">
        <h2>Useful links</h2>
        <ul>
          <li><a href={withBase('/resume/')}>Resume (web)</a> or <a href={withBase(profile.resumePdf)} download="Bach-Nguyen-Resume.pdf">PDF</a></li>
          <li><a href={withBase('/projects/')}>Projects and case studies</a></li>
          <li><a href={withBase('/research/')}>Thesis research</a></li>
        </ul>
        <p class="muted">Based in {profile.location}. There is no contact form on this site, so nothing you send goes through a third party.</p>
        <p class="muted">
          The <button type="button" class="linklike" data-open-chat>Ask Bach</button> assistant can answer quick questions about my work, but it is an
          AI, not me. For anything that needs a reply, please email.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s-7); align-items: start; }
  .channels { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .channel { padding: var(--s-5); }
  .channel .eyebrow { margin-bottom: var(--s-2); }
  .channel-value { font-family: var(--serif); font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem); font-weight: 500; overflow-wrap: anywhere; }
  .channel p { margin: var(--s-2) 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .contact-side h2 { font-size: 1rem; margin-bottom: var(--s-3); }
  .contact-side ul { margin: 0 0 var(--s-5); padding-left: 1.1rem; }
  .contact-side li { margin: .35rem 0; }
  .muted { color: var(--muted); font-size: var(--fs-sm); }
  .linklike { padding: 0; border: 0; background: none; color: var(--accent-ink); font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
