---
import { profile } from '../data/profile';
import { withBase } from '../lib/urls';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-id">
      <a href={withBase('/')} class="footer-brand">
        <svg class="brand-lockup" viewBox="0 0 280 64" role="img" aria-label="Bach Nguyen">
          <rect x="2" y="2" width="60" height="60" rx="16" class="lockup-tile"></rect>
          <text x="27" y="46" font-family="Newsreader, Georgia, serif" font-size="44" font-weight="600" class="lockup-b" text-anchor="middle">B</text>
          <text x="45" y="52" font-family="Newsreader, Georgia, serif" font-size="22" font-weight="600" fill="#7aa0ff" text-anchor="middle">n</text>
          <text x="78" y="34" class="logo-ink" font-family="Newsreader, Georgia, serif" font-size="26" font-weight="600">Bach Nguyen</text>
          <text x="79" y="51" class="logo-muted" font-family="Inter, system-ui, sans-serif" font-size="11">Math &amp; Computer Science</text>
        </svg>
      </a>
      <p>{profile.headline}. {profile.location}.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        <li><a href={withBase('/projects/')}>Projects</a></li>
        <li><a href={withBase('/research/')}>Research</a></li>
        <li><a href={withBase('/experience/')}>Experience</a></li>
        <li><a href={withBase('/resume/')}>Resume</a></li>
        <li><a href={withBase('/contact/')}>Contact</a></li>
      </ul>
      <ul>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
        <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={withBase(profile.resumePdf)}>Resume (PDF)</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-base">
    <p>© {year} Bach Nguyen. Built with Astro; <a href="https://github.com/bachnguyennn/bachnguyennn.github.io" target="_blank" rel="noopener noreferrer">source on GitHub</a>. No analytics or tracking.</p>
  </div>
</footer>

<style>
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-6); padding-block: var(--s-7) var(--s-6); }
  .footer-id { max-width: 34ch; }
  .footer-id p { margin: var(--s-3) 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .footer-brand { display: inline-block; }
  .brand-lockup { height: 44px; width: auto; }
  .lockup-tile { fill: #19202e; }
  .lockup-b { fill: #ffffff; }

  .footer-nav { display: flex; gap: var(--s-7); }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-1); }
  .footer-nav a { display: inline-block; padding: .2rem 0; color: var(--ink-2); font-size: var(--fs-sm); text-decoration: none; }
  .footer-nav a:hover { color: var(--accent-ink); text-decoration: underline; }

  .footer-base { padding-block: var(--s-4) var(--s-6); border-top: 1px solid var(--line); }
  .footer-base p { margin: 0; font-size: var(--fs-xs); color: var(--faint); }
  .footer-base a { color: inherit; }

  /* Leave room so the chat launcher never covers footer links on small screens. */
  @media (max-width: 640px) {
    .footer-base { padding-bottom: calc(var(--s-6) + 64px); }
    .footer-nav { gap: var(--s-6); }
  }
</style>
