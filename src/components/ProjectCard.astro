---
// One project as a card. `feature` is the large homepage variant with room for a diagram or
// image; `row` is the dense directory variant.
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import { projectCategories } from '../lib/taxonomy';
import { displayTitle, hasInternalPage, projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
  variant?: 'feature' | 'row';
  /** Heading level for the title. */
  level?: 2 | 3;
}

const { project, variant = 'row', level = 3 } = Astro.props;
const d = project.data;
const href = projectHref(project);
const internal = hasInternalPage(project);
const Heading = `h${level}` as 'h2' | 'h3';
const linkLabel = d.href ? 'Read the research' : internal ? 'Read the case study' : 'View on GitHub';
const hasVisual = Astro.slots.has('visual') || d.cover;
---

<article class:list={['project-card', 'card', `project-${variant}`, { 'has-visual': variant === 'feature' && hasVisual }]} data-categories={d.categories.join(' ')}>
  {variant === 'feature' && hasVisual && (
    <div class:list={['project-visual', { 'visual-diagram': Astro.slots.has('visual') }]}>
      {Astro.slots.has('visual') ? (
        <slot name="visual" />
      ) : (
        d.cover && <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[360, 540, 720, 1080]} sizes="(min-width: 960px) 520px, calc(100vw - 4rem)" loading="lazy" />
      )}
    </div>
  )}

  <div class="project-body">
    <div class="project-meta">
      <StatusBadge status={d.status} note={d.statusNote} />
      <span class="meta">{d.categories.map((c) => projectCategories[c]).join(' · ')}</span>
      <span class="meta project-year">{d.period}</span>
    </div>

    <Heading class="project-title">
      <a href={href} {...(internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{displayTitle(project)}</a>
    </Heading>

    <p class="project-problem">{d.problem}</p>
    {variant === 'feature' && <p class="project-summary">{d.summary}</p>}

    {d.result && (
      <div class="project-result">
        <span class="result-value">{d.result.value}</span>
        <span class="result-label">{d.result.label}</span>
        {d.result.context && <span class="result-context">{d.result.context}</span>}
      </div>
    )}

    <ul class="tags project-stack" aria-label="Technologies">
      {d.stack.slice(0, variant === 'feature' ? 7 : 6).map((t) => <li class="tag">{t}</li>)}
    </ul>

    <div class="project-links">
      <a class="text-link" href={href} {...(internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
        {linkLabel}<span class="visually-hidden"> on {displayTitle(project)}</span> <span class="arrow" aria-hidden="true">→</span>
      </a>
      {internal && d.github && (
        <a class="text-link secondary" href={d.github} target="_blank" rel="noopener noreferrer">
          Code<span class="visually-hidden"> for {displayTitle(project)} on GitHub</span>
        </a>
      )}
      {d.demo && (
        <a class="text-link secondary" href={d.demo.url} target="_blank" rel="noopener noreferrer" title={d.demo.note}>
          {d.demo.label}<span class="visually-hidden"> for {displayTitle(project)}</span>
        </a>
      )}
    </div>
    {d.statusNote && variant === 'feature' && <p class="project-note">{d.statusNote}</p>}
  </div>
</article>

<style>
  .project-card { overflow: hidden; transition: border-color .15s ease, box-shadow .15s ease; }
  .project-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .project-card:focus-within { border-color: var(--accent); }

  .project-body { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); flex: 1; }
  .project-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .75rem; }
  .project-year { margin-left: auto; }

  .project-title { font-family: var(--serif); font-size: 1.45rem; font-weight: 500; letter-spacing: -.01em; line-height: 1.2; }
  .project-title a { color: var(--ink); text-decoration: none; }
  .project-title a:hover { color: var(--accent-ink); }
  /* Whole card is clickable through the title link, without nesting links. */
  .project-title a::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .project-links, .project-links a { position: relative; z-index: 1; }

  .project-problem { margin: 0; color: var(--ink-2); }
  .project-summary { margin: 0; color: var(--muted); font-size: .9375rem; }

  .project-result {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .65rem;
    padding: var(--s-3) var(--s-4); border-left: 2px solid var(--accent); background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .result-value { font-family: var(--serif); font-size: 1.35rem; font-weight: 600; color: var(--accent-ink); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .result-label { font-size: .875rem; font-weight: 500; color: var(--ink); }
  .result-context { flex-basis: 100%; font-size: .8rem; line-height: 1.45; color: var(--muted); }

  .project-links { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; margin-top: auto; padding-top: var(--s-2); font-size: .9rem; }
  .project-links .secondary { color: var(--muted); }
  .project-links .secondary:hover { color: var(--accent-ink); }
  .project-note { margin: 0; font-size: .78rem; line-height: 1.45; color: var(--faint); }

  /* feature variant */
  .project-feature.has-visual { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .project-visual {
    display: flex; align-items: center; justify-content: center; padding: var(--s-5);
    background: var(--surface-2); border-right: 1px solid var(--line); min-height: 100%;
  }
  .project-visual :global(img) { width: 100%; height: auto; border-radius: var(--radius-sm); border: 1px solid var(--line); background: #fff; }
  .project-visual :global(.figure-diagram) { margin: 0; width: 100%; }

  @media (max-width: 960px) {
    .project-feature.has-visual { grid-template-columns: minmax(0, 1fr); }
    .project-visual { border-right: 0; border-bottom: 1px solid var(--line); order: -1; }
    /* Diagrams read better after the text that introduces them. */
    .project-visual.visual-diagram { order: 1; border-bottom: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .project-body { padding: var(--s-4); }
    .project-year { margin-left: 0; }
  }
</style>
