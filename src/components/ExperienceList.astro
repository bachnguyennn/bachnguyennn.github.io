---
// Experience entries, rendered from src/data/experience.ts at build time (the canonical record).
// With `live`, the browser also asks the FastAPI backend (GET /content/experience, backed by Cosmos DB)
// for records that are not on the page yet. Known ids are never replaced, so visitors with and without
// JavaScript see the same history; see src/lib/experience-merge.ts for the full policy.
import type { ExperienceEntry } from '../data/experience';

interface Props {
  entries: ExperienceEntry[];
  // Show highlight bullets (the /experience page) or just role, org and date (the homepage).
  details?: boolean;
  live?: boolean;
}

const { entries, details = false, live = false } = Astro.props;

// Same base URL as ChatWidget: PUBLIC_CHAT_API_URL, defaulting to the deployed Azure Container App.
const apiUrl = (
  import.meta.env.PUBLIC_CHAT_API_URL ?? 'https://ask-bach-api.yellowbush-fb5a973b.canadacentral.azurecontainerapps.io'
).replace(/\/$/, '');

const orgLine = (e: ExperienceEntry) => [e.org, e.orgDetail, e.location].filter(Boolean).join(' · ');
---

<ul class="entries" data-experience-list data-api={live ? apiUrl : undefined} data-details={details ? 'true' : undefined}>
  {entries.map((e) => (
    <li class="entry" id={e.id} data-id={e.id} data-start={e.start} data-end={e.end}>
      <div class="top"><h3>{e.role}{e.roleDetail && `, ${e.roleDetail}`}</h3><span class="date">{e.date}</span></div>
      <p class="sub">{orgLine(e)}</p>
      {details && <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>}
    </li>
  ))}
</ul>

<script>
  import { planMerge, type ApiExperience } from '../lib/experience-merge';

  const TIMEOUT_MS = 6000;

  // Built with textContent only: API data is never parsed as HTML.
  function renderEntry(e: ApiExperience, details: boolean): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'entry';
    li.id = e.id;
    li.dataset.id = e.id;

    const top = document.createElement('div');
    top.className = 'top';
    const role = document.createElement('h3');
    role.textContent = e.role;
    const date = document.createElement('span');
    date.className = 'date';
    date.textContent = e.period;
    top.append(role, date);

    const org = document.createElement('p');
    org.className = 'sub';
    org.textContent = e.organization;
    li.append(top, org);

    if (details && e.highlights.length) {
      const bullets = document.createElement('ul');
      for (const h of e.highlights) {
        const item = document.createElement('li');
        item.textContent = h;
        bullets.appendChild(item);
      }
      li.appendChild(bullets);
    }
    return li;
  }

  async function loadExperience(list: HTMLElement) {
    const details = list.dataset.details === 'true';
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li[data-id]')];
    const staticEntries = items.map((li) => ({ id: li.dataset.id!, start: li.dataset.start ?? '', end: li.dataset.end ?? '' }));
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

    try {
      const response = await fetch(`${list.dataset.api}/content/experience`, { signal: controller.signal });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const plan = planMerge(staticEntries, await response.json());

      for (const { record, before } of plan.additions) {
        if (list.querySelector(`:scope > [data-id="${CSS.escape(record.id)}"]`)) continue;
        const anchor = before ? list.querySelector(`:scope > [data-id="${CSS.escape(before)}"]`) : null;
        list.insertBefore(renderEntry(record, details), anchor);
      }
      if (plan.ignored.length) console.info('Kept the page copy for API records:', plan.ignored.join(', '));
    } catch (error) {
      // Keep the build-time entries.
      console.info('Unable to load experience from API:', error);
    } finally {
      clearTimeout(timer);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-experience-list][data-api]').forEach(loadExperience);
</script>
