---
// Experience entries rendered into static HTML from src/data/experience.ts (the canonical record).
// With `live`, the browser also asks the Ask Bach content API (GET /content/experience, backed by
// Cosmos DB) for records that are not on the page yet. Known ids are never replaced; see
// src/lib/experience-merge.ts for the full reconciliation policy.
import type { ExperienceEntry } from '../data/experience';

interface Props {
  entries: ExperienceEntry[];
  variant?: 'compact' | 'full';
  live?: boolean;
  /** Heading level for role titles, to keep the page outline correct. */
  level?: 3 | 4;
}

const { entries, variant = 'full', live = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';

// Same base URL as ChatWidget: PUBLIC_CHAT_API_URL, defaulting to the deployed Azure Container App.
const apiUrl = (
  import.meta.env.PUBLIC_CHAT_API_URL ?? 'https://ask-bach-api.yellowbush-fb5a973b.canadacentral.azurecontainerapps.io'
).replace(/\/$/, '');
---

<ol
  class:list={['xp-list', `xp-${variant}`]}
  data-experience-list
  data-api={live ? apiUrl : undefined}
  data-variant={variant}
  data-level={level}
>
  {entries.map((e) => (
    <li class="xp" id={e.id} data-id={e.id} data-start={e.start} data-end={e.end}>
      <div class="xp-when">
        <span class="xp-date">{e.date}</span>
        {variant === 'full' && <span class="xp-loc">{e.location}</span>}
      </div>
      <div class="xp-body">
        <Heading class="xp-role">
          {e.role}
          {e.roleDetail && <span class="xp-role-detail">, {e.roleDetail}</span>}
        </Heading>
        <p class="xp-org">
          {e.org}
          {e.orgDetail && <span class="xp-org-detail"> · {e.orgDetail}</span>}
        </p>
        {variant === 'compact' ? (
          <p class="xp-summary">{e.summary}</p>
        ) : (
          <>
            <ul class="xp-bullets">{e.bullets.map((b) => <li>{b}</li>)}</ul>
            {e.skills.length > 0 && (
              <ul class="tags xp-skills" aria-label="Skills used">
                {e.skills.map((s) => <li class="tag">{s}</li>)}
              </ul>
            )}
          </>
        )}
      </div>
    </li>
  ))}
</ol>

<script>
  import { planMerge, type ApiExperience } from '../lib/experience-merge';

  const TIMEOUT_MS = 6000;
  let request: Promise<unknown> | null = null;

  // One request per page, however many lists ask for it.
  function fetchExperience(api: string): Promise<unknown> {
    request ??= (async () => {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const res = await fetch(`${api}/content/experience`, { signal: controller.signal, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } finally {
        clearTimeout(timer);
      }
    })();
    return request;
  }

  // Built with textContent only: API data is never parsed as HTML.
  function renderEntry(r: ApiExperience, variant: string, level: string): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'xp';
    li.id = r.id;
    li.dataset.id = r.id;
    li.dataset.source = 'api';

    const when = document.createElement('div');
    when.className = 'xp-when';
    const date = document.createElement('span');
    date.className = 'xp-date';
    date.textContent = r.period;
    when.append(date);

    const body = document.createElement('div');
    body.className = 'xp-body';
    const role = document.createElement(level === '4' ? 'h4' : 'h3');
    role.className = 'xp-role';
    role.textContent = r.role;
    const org = document.createElement('p');
    org.className = 'xp-org';
    org.textContent = r.organization;
    body.append(role, org);

    if (variant === 'full' && r.highlights.length) {
      const ul = document.createElement('ul');
      ul.className = 'xp-bullets';
      for (const h of r.highlights) {
        const item = document.createElement('li');
        item.textContent = h;
        ul.append(item);
      }
      body.append(ul);
    } else if (r.highlights[0]) {
      const summary = document.createElement('p');
      summary.className = 'xp-summary';
      summary.textContent = r.highlights[0];
      body.append(summary);
    }

    li.append(when, body);
    return li;
  }

  async function enhance(list: HTMLElement) {
    const api = list.dataset.api;
    if (!api) return;
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li[data-id]')];
    const staticEntries = items.map((li) => ({ id: li.dataset.id!, start: li.dataset.start ?? '', end: li.dataset.end ?? '' }));

    try {
      const plan = planMerge(staticEntries, await fetchExperience(api));
      for (const { record, before } of plan.additions) {
        if (list.querySelector(`:scope > [data-id="${CSS.escape(record.id)}"]`)) continue;
        const node = renderEntry(record, list.dataset.variant ?? 'full', list.dataset.level ?? '3');
        const anchor = before ? list.querySelector(`:scope > [data-id="${CSS.escape(before)}"]`) : null;
        list.insertBefore(node, anchor);
      }
      if (plan.ignored.length) {
        console.info('[experience] Kept the page copy for API records:', plan.ignored.join(', '));
      }
    } catch (error) {
      // The static list is complete on its own; nothing to show the visitor.
      console.info('[experience] Content API unavailable; showing the built-in record.', error);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-experience-list][data-api]').forEach(enhance);
</script>

<style>
  .xp-list { list-style: none; margin: 0; padding: 0; }
  .xp {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--s-2) var(--s-6);
    padding-block: var(--s-5); border-top: 1px solid var(--line);
  }
  .xp:first-child { border-top: 0; padding-top: 0; }
  .xp-when { display: flex; flex-direction: column; gap: .15rem; padding-top: .2rem; }
  .xp-date { font: 500 .8rem/1.4 var(--mono); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .xp-loc { font-size: var(--fs-xs); color: var(--faint); }
  .xp-role { font-size: 1.0625rem; font-weight: 600; line-height: 1.35; }
  .xp-role-detail { font-weight: 400; color: var(--muted); }
  .xp-org { margin: .15rem 0 0; color: var(--muted); font-size: .9375rem; }
  .xp-org-detail { color: var(--faint); }
  .xp-summary { margin: var(--s-2) 0 0; color: var(--ink-2); font-size: .9375rem; }
  .xp-bullets { margin: var(--s-3) 0 0; padding-left: 1.1rem; color: var(--ink-2); }
  .xp-bullets li { margin: .35rem 0; padding-left: .15rem; }
  .xp-bullets li::marker { color: var(--faint); }
  .xp-skills { margin-top: var(--s-3); }
  .xp:target { scroll-margin-top: calc(var(--header-h) + 1rem); }
  .xp:target .xp-role { color: var(--accent-ink); }

  .xp-compact .xp { grid-template-columns: 9.5rem minmax(0, 1fr); padding-block: var(--s-4); }
  .xp-compact .xp:first-child { padding-top: 0; }

  @media (max-width: 640px) {
    .xp, .xp-compact .xp { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
    .xp-when { flex-direction: row; flex-wrap: wrap; gap: .1rem .75rem; padding: 0; }
  }
</style>
