---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';

const path = (Astro.url.pathname.replace(/\/$/, '') || '/');
const rel = basePath && path.startsWith(basePath) ? path.slice(basePath.length) || '/' : path;

const isProjects = rel === '/projects' || rel.startsWith('/projects/');
const isExperience = rel === '/experience';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={href('/')} aria-label="Bach Nguyen — home">
      <svg class="brand-mark" width="42" height="32" viewBox="0 0 64 48" aria-hidden="true">
        <text x="22" y="36" class="logo-ink" font-family="Newsreader, Georgia, serif" font-size="40" font-weight="600" text-anchor="middle">B</text>
        <text x="39" y="42" class="logo-accent" font-family="Newsreader, Georgia, serif" font-size="20" font-weight="600" text-anchor="middle">n</text>
      </svg>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={href('/projects')} class={isProjects ? 'active' : ''}>Projects</a>
      <a href={href('/experience')} class={isExperience ? 'active' : ''}>Experience</a>
      <a href={href('/Resume.pdf')} target="_blank" rel="noopener">Resume</a>
    </nav>
  </div>
</header>
