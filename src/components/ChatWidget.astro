---
// Floating "Chat with me" widget that talks to the FastAPI RAG backend (POST /ask → { answer, sources }).
// Defaults to the deployed Azure Container App; set PUBLIC_CHAT_API_URL to override
// (e.g. PUBLIC_CHAT_API_URL=http://127.0.0.1:8000 for a local uvicorn).
// If the API is down or slow, the widget says so and points to email; the rest of the site never depends on it.
import { profile } from '../data/profile';

const apiUrl = (
  import.meta.env.PUBLIC_CHAT_API_URL ?? 'https://ask-bach-api.yellowbush-fb5a973b.canadacentral.azurecontainerapps.io'
).replace(/\/$/, '');

const starters = [
  'What projects has Bach built?',
  'What is Bach researching?',
  'How has Bach used Azure?',
  'How can I contact Bach?',
];
---

<div class="chat" data-api={apiUrl} data-email={profile.email}>
  <div class="chat-panel" id="chat-panel" role="dialog" aria-label="Chat with Bach" hidden>
    <div class="chat-head">
      <div>
        <strong>Ask Bach</strong>
        <span>An AI assistant, not Bach. Answers come from his notes and can be wrong.</span>
      </div>
      <button class="chat-close" type="button" aria-label="Close chat">&times;</button>
    </div>

    <ol class="chat-log" aria-live="polite">
      <li class="msg bot">Hi! I'm a bot trained on Bach's resume and projects. Ask me anything.</li>
      <li class="chat-starters">
        {starters.map((q) => <button type="button" data-q={q}>{q}</button>)}
      </li>
    </ol>

    <form class="chat-form">
      <input name="q" type="text" placeholder="Ask a question…" autocomplete="off" aria-label="Your question" maxlength="500" required />
      <button type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" /></svg>
      </button>
    </form>
    <p class="chat-foot">Prefer a person? <a href={`mailto:${profile.email}`}>Email Bach</a></p>
  </div>

  <button class="chat-toggle" type="button" aria-label="Chat with me" aria-expanded="false" aria-controls="chat-panel">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2z" />
    </svg>
    <span>Chat with me</span>
  </button>
</div>

<script>
  type Source = { source: string; chunk_id: number };
  const TIMEOUT_MS = 45000; // a cold container can take a while to load the embedding model

  const root = document.querySelector<HTMLElement>('.chat');
  if (root) {
    const api = root.dataset.api!;
    const email = root.dataset.email!;
    const panel = root.querySelector<HTMLElement>('.chat-panel')!;
    const toggle = root.querySelector<HTMLButtonElement>('.chat-toggle')!;
    const close = root.querySelector<HTMLButtonElement>('.chat-close')!;
    const log = root.querySelector<HTMLOListElement>('.chat-log')!;
    const starters = root.querySelector<HTMLElement>('.chat-starters')!;
    const form = root.querySelector<HTMLFormElement>('.chat-form')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const send = form.querySelector<HTMLButtonElement>('button')!;
    let busy = false;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));
    close.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    // Text only: model output is never parsed as HTML.
    const addMessage = (role: 'user' | 'bot', text: string) => {
      const li = document.createElement('li');
      li.className = `msg ${role}`;
      li.textContent = text;
      log.append(li);
      log.scrollTop = log.scrollHeight;
      return li;
    };

    const addSources = (li: HTMLElement, sources: Source[]) => {
      const names = [...new Set(sources.map((s) => s.source).filter((s) => typeof s === 'string'))];
      if (!names.length) return;
      const small = document.createElement('small');
      small.textContent = `Based on: ${names.map((n) => n.replace(/\.txt$/, '').replace(/[_-]+/g, ' ')).join(', ')}`;
      li.append(small);
    };

    const addError = (timedOut: boolean) => {
      const li = addMessage('bot', timedOut ? 'Sorry, that took too long. ' : "Sorry, I couldn't reach the server. ");
      li.append('You can email Bach at ');
      const a = document.createElement('a');
      a.href = `mailto:${email}`;
      a.textContent = email;
      li.append(a, '.');
    };

    const ask = async (question: string) => {
      if (busy) return;
      busy = true;
      starters.hidden = true;
      addMessage('user', question);
      send.disabled = true;
      const pending = addMessage('bot', 'Thinking…');
      pending.classList.add('pending');
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

      try {
        const res = await fetch(`${api}/ask`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question }),
          signal: controller.signal,
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: { answer?: unknown; sources?: unknown } = await res.json();
        if (typeof data.answer !== 'string' || !data.answer.trim()) throw new Error('Malformed response');
        pending.remove();
        const li = addMessage('bot', data.answer);
        if (Array.isArray(data.sources)) addSources(li, data.sources as Source[]);
      } catch (err) {
        console.error('Chat request failed:', err);
        pending.remove();
        addError(controller.signal.aborted);
      } finally {
        clearTimeout(timer);
        send.disabled = false;
        busy = false;
        input.focus();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      input.value = '';
      ask(question);
    });
    starters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-q]');
      if (btn?.dataset.q) ask(btn.dataset.q);
    });
  }
</script>

<style>
  .chat {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .75rem;
    font-family: var(--sans);
  }

  .chat-toggle {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .7rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font: 600 .92rem var(--sans);
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(0 0 0 / .18);
    transition: transform .15s ease;
  }
  .chat-toggle:hover { transform: translateY(-2px); }
  .chat-toggle:focus-visible, .chat button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .chat-panel {
    width: min(360px, calc(100vw - 2rem));
    height: min(480px, calc(100dvh - 7rem));
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgb(0 0 0 / .2);
    overflow: hidden;
  }
  .chat-panel[hidden] { display: none; }

  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: .75rem;
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .chat-head strong { display: block; font-size: .98rem; }
  .chat-head span { font-size: .8rem; color: var(--muted); }
  .chat-close {
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .chat-log {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: .6rem;
  }
  .msg {
    max-width: 85%;
    padding: .55rem .8rem;
    border-radius: 12px;
    font-size: .92rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .msg.bot { align-self: flex-start; background: var(--surface); color: var(--ink); }
  .msg.user { align-self: flex-end; background: var(--accent); color: var(--bg); }
  .msg.pending { color: var(--faint); font-style: italic; }
  .msg :global(a) { color: inherit; text-decoration: underline; }
  .msg :global(small) { display: block; margin-top: .35rem; font-size: .75rem; color: var(--faint); }

  .chat-starters { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chat-starters[hidden] { display: none; }
  .chat-starters button {
    padding: .3rem .6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: .8rem;
    cursor: pointer;
  }
  .chat-starters button:hover { color: var(--ink); border-color: var(--faint); }

  .chat-form {
    display: flex;
    gap: .5rem;
    padding: .75rem;
    border-top: 1px solid var(--line);
  }
  .chat-form input {
    flex: 1;
    min-width: 0;
    padding: .55rem .75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 16px; /* 16px stops iOS from zooming on focus */
  }
  .chat-form input:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: transparent; }
  .chat-form button {
    display: grid;
    place-items: center;
    width: 40px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .chat-form button:disabled { opacity: .5; cursor: wait; }
  .chat-foot { margin: 0; padding: 0 .75rem .6rem; font-size: .75rem; color: var(--faint); }

  @media (max-width: 480px) {
    .chat { right: 1rem; bottom: 1rem; }
    .chat-toggle span { display: none; }
    .chat-toggle { padding: .85rem; }
  }
</style>

