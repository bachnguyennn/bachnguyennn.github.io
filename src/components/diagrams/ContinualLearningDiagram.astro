---
// Conceptual diagrams for /research/: the task-incremental setting, and the published CPG
// procedure (Hung et al., 2019). No results are shown here.
import Flow, { type FlowStep } from './Flow.astro';

interface Props { variant: 'setting' | 'cpg' }
const { variant } = Astro.props;

const setting: FlowStep[] = [
  { kicker: 'Task 1', title: 'Learn classes A', detail: 'train on task 1 data' },
  { kicker: 'Task 2', title: 'Learn classes B', detail: 'task 1 data no longer available' },
  { kicker: 'Task 3', title: 'Learn classes C', detail: 'same model, same budget' },
  { kicker: 'Evaluate', title: 'Every task seen so far', detail: 'forgetting = drop on old tasks', tone: 'accent' },
];

const cpg: FlowStep[] = [
  { kicker: '1 · Pick', title: 'Train free weights', detail: 'reuse frozen weights from earlier tasks through a learned binary mask' },
  { kicker: '2 · Compact', title: 'Prune, then freeze', detail: 'surviving weights are owned by this task; pruned ones return to the free pool' },
  { kicker: '3 · Grow', title: 'Add capacity if needed', detail: 'only when the free pool runs out', tone: 'accent' },
];
---

<figure class="figure-diagram">
  {variant === 'setting' ? (
    <>
      <Flow steps={setting} label="Continual learning: tasks arrive in sequence" />
      <figcaption>Continual learning: one model learns tasks in sequence and is evaluated on all of them.</figcaption>
    </>
  ) : (
    <>
      <Flow steps={cpg} label="CPG: pick, compact, grow" />
      <figcaption>CPG’s per-task cycle (Hung et al., 2019). Frozen weights never change, so earlier tasks cannot be overwritten.</figcaption>
    </>
  )}
</figure>
