---
// Request path for POST /ask, as implemented in AskBachBot (app/src/rag.py).
import Flow, { type FlowStep } from './Flow.astro';

interface Props { compact?: boolean; caption?: boolean; vertical?: boolean }
const { compact = false, caption = true, vertical = false } = Astro.props;

const steps: FlowStep[] = [
  { kicker: 'Input', title: 'Question', detail: 'FastAPI validates length and schema' },
  {
    title: 'Retrieve',
    branches: [
      { kicker: 'Lexical', title: 'BM25', detail: 'top 10 chunks' },
      { kicker: 'Dense', title: 'MiniLM + Cosmos DB', detail: 'vector search, top 10' },
    ],
  },
  { kicker: 'Fuse', title: 'Reciprocal Rank Fusion', detail: 'k = 60, keep top 3' },
  { kicker: 'Generate', title: 'LLM, strict JSON', detail: 'answer + evidence IDs', tone: 'accent' },
  { kicker: 'Validate', title: 'Resolve sources in Python', detail: 'IDs → (document, chunk)' },
];
---

<figure class="figure-diagram">
  <Flow steps={steps} label="Ask Bach request pipeline" compact={compact} vertical={vertical} />
  {caption && (
    <figcaption>
      One request through <code>POST /ask</code>. The model only sees numbered chunks; source names are attached by code after generation.
    </figcaption>
  )}
</figure>
