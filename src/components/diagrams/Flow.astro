---
// A left-to-right pipeline diagram built from real HTML, so it stays selectable, readable by
// screen readers, theme-aware and responsive (it stacks vertically on narrow screens).
// Each step can fork into parallel branches that rejoin at the next step.
export interface FlowStep {
  kicker?: string;
  title: string;
  detail?: string;
  tone?: 'accent' | 'muted' | 'store';
  branches?: { kicker?: string; title: string; detail?: string }[];
}

interface Props {
  steps: FlowStep[];
  /** Short accessible name for the diagram, e.g. "Ask Bach request pipeline". */
  label: string;
  lane?: string;
  laneNote?: string;
  compact?: boolean;
  /** Always stack top-to-bottom, e.g. inside a narrow card column. */
  vertical?: boolean;
}

const { steps, label, lane, laneNote, compact = false, vertical = false } = Astro.props;
---

<div class:list={['flow', { 'flow-compact': compact, 'flow-vertical': vertical }]}>
  {lane && (
    <p class="flow-lane">
      <span>{lane}</span>
      {laneNote && <span class="flow-lane-note">{laneNote}</span>}
    </p>
  )}
  <ol class="flow-track" aria-label={label}>
    {steps.map((s) => (
      <li class:list={['flow-step', s.tone && `tone-${s.tone}`, { 'has-branches': s.branches }]}>
        {s.branches ? (
          <ul class="flow-branches">
            {s.branches.map((b) => (
              <li class="flow-node">
                {b.kicker && <span class="flow-kicker">{b.kicker}</span>}
                <strong>{b.title}</strong>
                {b.detail && <span class="flow-detail">{b.detail}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <div class="flow-node">
            {s.kicker && <span class="flow-kicker">{s.kicker}</span>}
            <strong>{s.title}</strong>
            {s.detail && <span class="flow-detail">{s.detail}</span>}
          </div>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  /* Layout responds to the diagram's own width (a narrow prose column or card), not the viewport. */
  .flow { margin: 0; container-type: inline-size; }
  .flow + .flow { margin-top: 1.25rem; }
  .flow-lane {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem;
    margin: 0 0 .6rem; font: 600 .72rem/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2);
  }
  .flow-lane-note { font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--muted); font-family: var(--sans); font-size: .82rem; }

  .flow-track {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr);
    gap: 1.6rem; align-items: stretch;
  }
  .flow-step { position: relative; display: flex; min-width: 0; }
  /* connector arrow to the next step */
  .flow-step:not(:last-child)::after {
    content: ''; position: absolute; top: 50%; right: -1.35rem; width: 1.1rem; height: 1px; background: var(--line-strong);
  }
  .flow-step:not(:last-child)::before {
    content: ''; position: absolute; top: calc(50% - 4px); right: -1.35rem; width: 0; height: 0;
    border-left: 6px solid var(--line-strong); border-top: 4px solid transparent; border-bottom: 4px solid transparent;
  }

  .flow-node {
    flex: 1; display: flex; flex-direction: column; gap: .2rem; min-width: 0;
    padding: .7rem .8rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface);
  }
  .flow-node strong { font-size: .86rem; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .flow-kicker { font: 500 .66rem/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
  .flow-detail { font-size: .78rem; line-height: 1.4; color: var(--muted); }

  .tone-accent .flow-node { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); background: var(--accent-soft); }
  .tone-accent .flow-kicker { color: var(--accent-ink); }
  .tone-store .flow-node { border-style: dashed; }
  .tone-muted .flow-node { background: transparent; }

  .flow-branches { list-style: none; margin: 0; padding: 0; flex: 1; display: grid; gap: .5rem; }

  .flow-compact .flow-track { gap: 1.3rem; }
  .flow-compact .flow-node { padding: .5rem .6rem; }
  .flow-compact .flow-detail { display: none; }

  @container (max-width: 600px) {
    .flow-track { grid-auto-flow: row; grid-auto-columns: auto; gap: 1.35rem; }
    .flow-step:not(:last-child)::after { top: auto; bottom: -1.1rem; right: auto; left: 1.5rem; width: 1px; height: .85rem; }
    .flow-step:not(:last-child)::before {
      top: auto; bottom: -1.2rem; right: auto; left: calc(1.5rem - 4px);
      border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 6px solid var(--line-strong); border-bottom: 0;
    }
    .flow-branches { grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
    .flow-compact .flow-detail { display: block; }
  }
  .flow-vertical .flow-track { grid-auto-flow: row; grid-auto-columns: auto; gap: 1.35rem; }
  .flow-vertical .flow-step:not(:last-child)::after { top: auto; bottom: -1.1rem; right: auto; left: 1.5rem; width: 1px; height: .85rem; }
  .flow-vertical .flow-step:not(:last-child)::before {
    top: auto; bottom: -1.2rem; right: auto; left: calc(1.5rem - 4px);
    border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 6px solid var(--line-strong); border-bottom: 0;
  }
  .flow-vertical .flow-branches { grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
  .flow-vertical .flow-detail { display: block; }
  
</style>
